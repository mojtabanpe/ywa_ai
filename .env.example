DATABASE_URL="postgresql://ywa:ywa@localhost:5432/ywa_ai?schema=public"
REDIS_HOST=localhost
REDIS_PORT=6379
PORT=3000
CORS_ORIGIN=http://localhost:4200
LLM_PROVIDER=gateway
LLM_API_BASE_URL=http://localhost:20128/v1
LLM_API_KEY=replace-with-your-key
LLM_MODEL=code
OPENAI_API_KEY=replace-with-your-openai-api-key
OPENAI_MODEL=gpt-5-mini
GEMINI_API_KEY=replace-with-your-gemini-api-key
GEMINI_API_BASE_URL=https://generativelanguage.googleapis.com/v1beta
GEMINI_PROXY_URL=http://localhost:7890
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image
GEMINI_OMNI_MODEL=gemini-omni-flash-preview
# Episode pipeline: video and voice providers (tried in priority order, falling back on failure)
HIGGSFIELD_API_KEY=replace-with-your-higgsfield-api-key
HIGGSFIELD_API_SECRET=replace-with-your-higgsfield-api-secret
ELEVENLABS_API_KEY=replace-with-your-elevenlabs-api-key
DEEPGRAM_API_KEY=replace-with-your-deepgram-api-key
# All outbound provider traffic goes through the local xray proxy (googleapis.com is not reachable directly)
PIPELINE_PROXY_URL=http://127.0.0.1:7890
