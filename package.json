{
  "name": "@ywa-ai/source",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.24.0",
  "engines": {
    "pnpm": ">=10"
  },
  "scripts": {
    "reel:free": "VIDEO_MODE=free TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\",\"ignoreDeprecations\":\"6.0\"}' ts-node --transpile-only tools/free-reel.ts",
    "voice:test": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\",\"ignoreDeprecations\":\"6.0\"}' ts-node --transpile-only tools/voice-test.ts",
    "voice:rank": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\",\"ignoreDeprecations\":\"6.0\"}' ts-node --transpile-only tools/voice-rank.ts",
    "episode": "TS_NODE_COMPILER_OPTIONS='{\"module\":\"CommonJS\",\"moduleResolution\":\"node\",\"ignoreDeprecations\":\"6.0\"}' ts-node --transpile-only tools/episode/run.ts",
    "dev:api": "nx serve api",
    "dev:admin": "nx serve admin",
    "build": "nx run-many -t build --projects=api,admin",
    "db:up": "docker compose up -d",
    "db:migrate": "prisma migrate dev",
    "db:generate": "prisma generate"
  },
  "private": true,
  "pnpm": {
    "onlyBuiltDependencies": [
      "@parcel/watcher",
      "@prisma/client",
      "@prisma/engines",
      "@swc/core",
      "esbuild",
      "lmdb",
      "msgpackr-extract",
      "nx",
      "prisma",
      "unrs-resolver"
    ],
    "ignoredBuiltDependencies": [
      "less"
    ]
  },
